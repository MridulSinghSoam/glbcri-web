# Where incubation applications are sent (Formspree / Web3Forms / Google Apps Script URL).
# Leave empty to run the forms in demo mode (saved in the browser only).
VITE_FORM_ENDPOINT=

# Optional: a separate endpoint for the contact form and event alerts.
VITE_CONTACT_ENDPOINT=

# Optional: a feed service JSON URL (e.g. Behold) if you are not using /api/instagram.
VITE_INSTAGRAM_FEED_URL=

# Server-side only (set in Vercel, never prefixed with VITE_): long-lived Instagram token for @glbajaj_cri.
IG_ACCESS_TOKEN=
